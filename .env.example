NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://fintech:fintech_dev@localhost:5433/fintech?schema=public
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL_SECONDS=900
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info
REDIS_URL=redis://localhost:6380
OUTBOX_POLL_INTERVAL_MS=1000

# Optional: enable webhooks with a stable 32-byte key (openssl rand -hex 32).
# API and worker must use the same key. Keep it private and backed up.
WEBHOOK_ENCRYPTION_KEY=
