  "info": {
    "title": "Fintech Transaction Platform",
    "description": "Wallet, ledger, transfer, reversal, and payment infrastructure API. See docs/API.md for response examples and error/retry semantics.",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "alex@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 12,
            "example": "correct-horse-battery-staple"
          },
          "firstName": {
            "type": "string",
            "example": "Alex"
          },
          "lastName": {
            "type": "string",
            "example": "Morgan"
          },
          "currency": {
            "type": "string",
            "enum": [
              "USD",
              "NGN"
            ],
            "default": "USD"
          }
        },
        "required": [
          "email",
          "password",
          "firstName",
          "lastName"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "alex@example.com"
          },
          "password": {
            "type": "string",
            "example": "correct-horse-battery-staple"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "CreateWalletDto": {
        "type": "object",
        "properties": {
          "currency": {
            "type": "string",
            "enum": [
              "USD",
              "NGN"
            ],
            "example": "NGN"
          }
        },
        "required": [
          "currency"
        ]
      },
      "CreateBeneficiaryDto": {
        "type": "object",
        "properties": {
          "walletId": {
            "type": "string",
            "format": "uuid",
            "description": "Wallet identifier to save as a beneficiary"
          },
          "label": {
            "type": "string",
            "example": "Primary recipient",
            "minLength": 1,
            "maxLength": 80
          }
        },
        "required": [
          "walletId",
          "label"
        ]
      },
      "CreateTransferDto": {
        "type": "object",
        "properties": {
          "sourceWalletId": {
            "type": "string",
            "format": "uuid",
            "description": "Source wallet identifier"
          },
          "destinationWalletId": {
            "type": "string",
            "format": "uuid",
            "description": "Direct destination identifier; mutually exclusive with beneficiaryId"
          },
          "beneficiaryId": {
            "type": "string",
            "format": "uuid",
            "description": "Saved beneficiary identifier; mutually exclusive with destinationWalletId"
          },
          "amountMinor": {
            "type": "string",
            "example": "2500",
            "description": "Positive amount in minor units encoded as a decimal string"
          }
        },
        "required": [
          "sourceWalletId",
          "amountMinor"
        ]
      },
      "CreateReversalDto": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string",
            "example": "Duplicate payment",
            "minLength": 1,
            "maxLength": 255,
            "description": "Optional reason retained with the immutable reversal record"
          }
        }
      },
      "Object": {
        "type": "object",
        "properties": {}
      },
      "CreateWebhookDto": {
        "type": "object",
        "properties": {}
      },
      "CreatePaymentDto": {
        "type": "object",
        "properties": {
          "walletId": {
            "type": "string"
          },
          "amountMinor": {
            "type": "string",
            "example": "2500",
            "description": "Positive integer minor units; wallet determines currency"
          }
        },
        "required": [
          "walletId",
          "amountMinor"
        ]
      }
    }
  }
}
