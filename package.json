{
  "name": "fintech-transaction-platform",
  "version": "1.0.0",
  "private": true,
  "description": "A production-style wallet and transaction platform rebuilt with NestJS, TypeScript, PostgreSQL, and Prisma.",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" --max-warnings=0",
    "start": "nest start",
    "dev:bootstrap": "docker compose stop api worker && docker compose up -d --wait postgres redis && npm run prisma:generate && npm run db:migrate:deploy",
    "start:dev": "npm run dev:bootstrap && nest start --watch",
    "start:prod": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "start:worker:dev": "npm run dev:bootstrap && nest start --entryFile worker --watch",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage --runInBand",
    "test:e2e": "jest --config test/jest-e2e.json --runInBand",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "ci": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run prisma:validate && npm run build",
    "local:setup": "node scripts/setup-local.mjs",
    "local:up": "npm run local:setup && docker compose up --build -d --wait",
    "local:down": "docker compose down",
    "local:smoke": "node --env-file=.env scripts/smoke-local.mjs",
    "paystack:check": "node scripts/paystack-test-account.mjs",
    "docs:export": "node scripts/export-openapi.mjs",
    "audit:ledger": "node scripts/audit-ledger.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.3",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.2.3",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/platform-express": "^11.2.3",
    "@nestjs/swagger": "^11.0.0",
    "@prisma/client": "^6.19.3",
    "bullmq": "^6.3.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "helmet": "^8.0.0",
    "ioredis": "^6.0.0",
    "nestjs-pino": "^4.0.0",
    "pino": "^9.0.0",
    "pino-http": "^10.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.2.3",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "@types/supertest": "^6.0.2",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.0.0",
    "globals": "^15.14.0",
    "jest": "^29.7.0",
    "prettier": "^3.9.6",
    "prisma": "^6.19.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  },
  "overrides": {
    "deepmerge-ts": ">=8.0.0",
    "multer": ">=2.2.1"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "src/**/*.(t|j)s"
    ],
    "coverageDirectory": "coverage",
    "testEnvironment": "node"
  }
}
