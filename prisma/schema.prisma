generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Currency {
  USD
  NGN
}

enum WalletStatus {
  ACTIVE
  FROZEN
  CLOSED
}

enum LedgerAccountKind {
  WALLET
  SYSTEM
}

enum TransferStatus {
  PENDING
  COMPLETED
}

enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum AuditAction {
  TRANSFER_CREATED
  TRANSFER_REVERSED
}

enum OutboxEventType {
  TRANSFER_COMPLETED
  TRANSFER_REVERSED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED
}

enum NotificationType {
  TRANSFER_COMPLETED
  TRANSFER_REVERSED
}

model User {
  id                 String              @id @default(uuid()) @db.Uuid
  email              String              @unique @db.VarChar(320)
  passwordHash       String              @db.VarChar(255)
  firstName          String              @db.VarChar(80)
  lastName           String              @db.VarChar(80)
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(3)
  wallets            Wallet[]
  sentTransfers      Transfer[]          @relation("TransferSender")
  beneficiaries      Beneficiary[]
  idempotencyRecords IdempotencyRecord[]
  reversals          TransferReversal[]  @relation("ReversalActor")
  auditLogs          AuditLog[]          @relation("AuditActor")
  outboxEvents       OutboxEvent[]
  notifications      Notification[]
}

model Wallet {
  id                  String        @id @default(uuid()) @db.Uuid
  userId              String        @db.Uuid
  ledgerAccountId     String        @unique @db.Uuid
  currency            Currency
  status              WalletStatus  @default(ACTIVE)
  currentBalanceMinor BigInt        @default(0)
  createdAt           DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime      @updatedAt @db.Timestamptz(3)
  user                User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  ledgerAccount       LedgerAccount @relation(fields: [ledgerAccountId], references: [id], onDelete: Restrict)
  outgoingTransfers   Transfer[]    @relation("TransferSourceWallet")
  incomingTransfers   Transfer[]    @relation("TransferDestinationWallet")
  beneficiaries       Beneficiary[]

  @@unique([userId, currency])
  @@index([userId])
}

model LedgerAccount {
  id            String            @id @default(uuid()) @db.Uuid
  kind          LedgerAccountKind
  currency      Currency
  allowNegative Boolean           @default(false)
  balanceMinor  BigInt            @default(0)
  systemKey     String?           @unique @db.VarChar(120)
  createdAt     DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime          @updatedAt @db.Timestamptz(3)
  wallet        Wallet?
  postings      LedgerPosting[]

  @@index([currency, kind])
}

model LedgerTransaction {
  id          String            @id @default(uuid()) @db.Uuid
  reference   String            @unique @db.VarChar(120)
  currency    Currency
  description String?           @db.VarChar(255)
  createdAt   DateTime          @default(now()) @db.Timestamptz(3)
  sealedAt    DateTime?         @db.Timestamptz(3)
  postings    LedgerPosting[]
  transfer    Transfer?
  reversal    TransferReversal?
}

model LedgerPosting {
  id                  String            @id @default(uuid()) @db.Uuid
  ledgerTransactionId String            @db.Uuid
  accountId           String            @db.Uuid
  amountMinor         BigInt
  createdAt           DateTime          @default(now()) @db.Timestamptz(3)
  ledgerTransaction   LedgerTransaction @relation(fields: [ledgerTransactionId], references: [id], onDelete: Restrict)
  account             LedgerAccount     @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([ledgerTransactionId, accountId])
  @@index([accountId, createdAt])
}

model Transfer {
  id                  String            @id @default(uuid()) @db.Uuid
  reference           String            @unique @db.VarChar(120)
  senderUserId        String            @db.Uuid
  sourceWalletId      String            @db.Uuid
  destinationWalletId String            @db.Uuid
  beneficiaryId       String?           @db.Uuid
  ledgerTransactionId String            @unique @db.Uuid
  currency            Currency
  amountMinor         BigInt
  status              TransferStatus    @default(PENDING)
  createdAt           DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime          @updatedAt @db.Timestamptz(3)
  completedAt         DateTime?         @db.Timestamptz(3)
  sender              User              @relation("TransferSender", fields: [senderUserId], references: [id], onDelete: Restrict)
  sourceWallet        Wallet            @relation("TransferSourceWallet", fields: [sourceWalletId], references: [id], onDelete: Restrict)
  destinationWallet   Wallet            @relation("TransferDestinationWallet", fields: [destinationWalletId], references: [id], onDelete: Restrict)
  beneficiary         Beneficiary?      @relation(fields: [beneficiaryId], references: [id], onDelete: Restrict)
  ledgerTransaction   LedgerTransaction @relation(fields: [ledgerTransactionId], references: [id], onDelete: Restrict)
  idempotencyRecord   IdempotencyRecord?
  reversal            TransferReversal?
  auditLogs           AuditLog[]

  @@index([senderUserId, createdAt])
  @@index([sourceWalletId, createdAt])
  @@index([destinationWalletId, createdAt])
}

model TransferReversal {
  id                  String            @id @default(uuid()) @db.Uuid
  reference           String            @unique @db.VarChar(120)
  transferId          String            @unique @db.Uuid
  actorUserId         String            @db.Uuid
  ledgerTransactionId String            @unique @db.Uuid
  currency            Currency
  amountMinor         BigInt
  reason              String?           @db.VarChar(255)
  createdAt           DateTime          @default(now()) @db.Timestamptz(3)
  transfer            Transfer          @relation(fields: [transferId], references: [id], onDelete: Restrict)
  actor               User              @relation("ReversalActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  ledgerTransaction   LedgerTransaction @relation(fields: [ledgerTransactionId], references: [id], onDelete: Restrict)
  idempotencyRecord   IdempotencyRecord?
  auditLog            AuditLog?

  @@index([actorUserId, createdAt])
}

model Beneficiary {
  id          String     @id @default(uuid()) @db.Uuid
  ownerUserId String     @db.Uuid
  walletId    String     @db.Uuid
  label       String     @db.VarChar(80)
  createdAt   DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @db.Timestamptz(3)
  deletedAt   DateTime?  @db.Timestamptz(3)
  owner       User       @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  wallet      Wallet     @relation(fields: [walletId], references: [id], onDelete: Restrict)
  transfers   Transfer[]

  @@unique([ownerUserId, walletId])
  @@index([ownerUserId, createdAt])
}

model IdempotencyRecord {
  id             String            @id @default(uuid()) @db.Uuid
  userId         String            @db.Uuid
  scope          String            @db.VarChar(64)
  key            String            @db.VarChar(128)
  requestHash    String            @db.Char(64)
  status         IdempotencyStatus @default(IN_PROGRESS)
  responseStatus Int?
  errorMessage   String?           @db.VarChar(255)
  transferId     String?           @unique @db.Uuid
  reversalId     String?           @unique @db.Uuid
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @db.Timestamptz(3)
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  transfer       Transfer?         @relation(fields: [transferId], references: [id], onDelete: Restrict)
  reversal       TransferReversal? @relation(fields: [reversalId], references: [id], onDelete: Restrict)

  @@unique([userId, scope, key])
  @@index([userId, createdAt])
}

model AuditLog {
  id          String            @id @default(uuid()) @db.Uuid
  actorUserId String            @db.Uuid
  action      AuditAction
  transferId  String            @db.Uuid
  reversalId  String?           @unique @db.Uuid
  createdAt   DateTime          @default(now()) @db.Timestamptz(3)
  actor       User              @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  transfer    Transfer          @relation(fields: [transferId], references: [id], onDelete: Restrict)
  reversal    TransferReversal? @relation(fields: [reversalId], references: [id], onDelete: Restrict)

  @@unique([action, transferId])
  @@index([actorUserId, createdAt])
}

model OutboxEvent {
  id            String          @id @default(uuid()) @db.Uuid
  type          OutboxEventType
  aggregateType String          @db.VarChar(64)
  aggregateId   String          @db.Uuid
  actorUserId   String          @db.Uuid
  payload       Json
  status        OutboxStatus    @default(PENDING)
  attempts      Int             @default(0)
  availableAt   DateTime        @default(now()) @db.Timestamptz(3)
  lockedAt      DateTime?       @db.Timestamptz(3)
  publishedAt   DateTime?       @db.Timestamptz(3)
  lastError     String?         @db.VarChar(500)
  createdAt     DateTime        @default(now()) @db.Timestamptz(3)
  actor         User            @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  notification  Notification?

  @@index([status, availableAt, createdAt])
  @@index([aggregateType, aggregateId])
  @@unique([type, aggregateId])
}

model Notification {
  id            String           @id @default(uuid()) @db.Uuid
  outboxEventId String           @unique @db.Uuid
  userId        String           @db.Uuid
  type          NotificationType
  subject       String           @db.VarChar(160)
  body          String           @db.VarChar(500)
  createdAt     DateTime         @default(now()) @db.Timestamptz(3)
  outboxEvent   OutboxEvent      @relation(fields: [outboxEventId], references: [id], onDelete: Restrict)
  user          User             @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
}
